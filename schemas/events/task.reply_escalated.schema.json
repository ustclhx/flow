{
  "$id": "https://flow.local/schemas/events/task.reply_escalated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "账本序号，单调递增"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
    },
    "type": {
      "type": "string",
      "const": "task.reply_escalated"
    },
    "workspace": {
      "type": "string",
      "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
      "description": "workspace 标识，形如 ws/<id>"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "description": "任务 id，由中枢在创建时分配"
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,63}$",
      "description": "操作者标识，例如 user、agent:claude、node:<id>、hub、scheduler"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "supervisor",
            "timeout",
            "wake_unavailable",
            "wake_failed",
            "wake_ended",
            "user_dismissed",
            "user_replied"
          ],
          "description": "supervisor 主动转交；timeout 超时；wake_unavailable 唤醒无法开始；wake_failed / wake_ended 唤醒失败或结束仍未回复；user_dismissed 用户忽略；user_replied 用户已回复"
        },
        "block_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "被结束的委托对应的 task.blocked seq（必须是当前这次卡住）"
        },
        "note": {
          "description": "说明，例如 supervisor 转交的理由",
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "reason",
        "block_seq"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "seq",
    "ts",
    "type",
    "workspace",
    "task_id",
    "actor",
    "payload"
  ],
  "additionalProperties": false,
  "title": "task.reply_escalated"
}

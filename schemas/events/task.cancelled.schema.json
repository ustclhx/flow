{
  "$id": "https://flow.local/schemas/events/task.cancelled.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "账本序号，单调递增"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
    },
    "type": {
      "type": "string",
      "const": "task.cancelled"
    },
    "workspace": {
      "type": "string",
      "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
      "description": "workspace 标识，形如 ws/<id>"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "description": "任务 id，由中枢在创建时分配"
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,63}$",
      "description": "操作者标识，例如 user、agent:claude、node:<id>、hub、scheduler"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "result": {
          "description": "取消时已执行的验收命令结果",
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "description": "结果摘要"
            },
            "artifacts": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "file",
                      "pr",
                      "commit",
                      "url",
                      "other"
                    ]
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "description": "文件路径、PR 链接、提交 sha 或 URL"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "ref"
                ],
                "additionalProperties": false,
                "title": "Task artifact"
              }
            },
            "verify": {
              "default": [],
              "description": "每条验收命令的结果",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cmd": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "执行的 argv"
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exit_code": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "退出码；被信号终止或超时时为 null"
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "timed_out": {
                    "default": false,
                    "type": "boolean"
                  },
                  "output_tail": {
                    "default": [],
                    "description": "合并 stdout/stderr 后的末尾若干行",
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "cmd",
                  "exit_code",
                  "duration_ms",
                  "timed_out",
                  "output_tail"
                ],
                "additionalProperties": false,
                "title": "Verify outcome",
                "description": "一条验收命令的执行结果"
              }
            },
            "executor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$",
              "description": "执行器类型，例如 fake、codex-orca、claude-sdk、codex-exec"
            },
            "node_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "description": "节点 id，节点首次启动时生成并保存在 state/node-id"
            },
            "reason": {
              "description": "失败原因的机器可读码，例如 timeout（超过 timeout_s 被停止）",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "session": {
              "description": "执行器会话 id（例如 Claude Agent SDK 的 session_id），便于事后查看或恢复",
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "cost": {
              "type": "object",
              "properties": {
                "usd": {
                  "description": "估算费用（美元）；未报告时省略",
                  "type": "number",
                  "minimum": 0
                },
                "turns": {
                  "description": "模型往返轮数",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false,
              "title": "Task cost",
              "description": "执行器上报的费用与用量（估算）"
            }
          },
          "required": [
            "summary",
            "artifacts",
            "verify",
            "executor",
            "node_id"
          ],
          "additionalProperties": false,
          "title": "Flow task result"
        },
        "node_id": {
          "description": "由持有租约的节点确认取消时填写",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "seq",
    "ts",
    "type",
    "workspace",
    "task_id",
    "actor",
    "payload"
  ],
  "additionalProperties": false,
  "title": "task.cancelled"
}

{
  "$id": "https://flow.local/schemas/events/task.branch_reported.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "账本序号，单调递增"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
    },
    "type": {
      "type": "string",
      "const": "task.branch_reported"
    },
    "workspace": {
      "type": "string",
      "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
      "description": "workspace 标识，形如 ws/<id>"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "description": "任务 id，由中枢在创建时分配"
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,63}$",
      "description": "操作者标识，例如 user、agent:claude、node:<id>、hub、scheduler"
    },
    "payload": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/-]*$",
          "description": "执行器创建的任务分支，例如 ustclhx/t-1"
        },
        "worktree": {
          "description": "任务 worktree（节点 realpath 后的绝对路径）；push_to / gh_scope 要求命令在其中执行，缺失即不满足",
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^\\/[^\\0\\n\\r]*$"
        },
        "repo_snapshot": {
          "description": "租约开始、worker 启动前节点对登记仓库的快照；push_to 的默认分支只取这里的值",
          "type": "object",
          "properties": {
            "remote_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[\\x21-\\x7e]+$",
              "description": "登记仓库 origin 的地址（只接受 github.com）"
            },
            "default_branch": {
              "description": "登记仓库的默认分支；取不到时省略（push_to 随之不满足）",
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/-]*$"
            }
          },
          "required": [
            "remote_url"
          ],
          "additionalProperties": false,
          "title": "Repo snapshot"
        }
      },
      "required": [
        "branch"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "seq",
    "ts",
    "type",
    "workspace",
    "task_id",
    "actor",
    "payload"
  ],
  "additionalProperties": false,
  "title": "task.branch_reported"
}

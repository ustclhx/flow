{
  "$id": "https://raindown.local/schemas/events/task.replied.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "账本序号，单调递增"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
    },
    "type": {
      "type": "string",
      "const": "task.replied"
    },
    "workspace": {
      "type": "string",
      "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
      "description": "workspace 标识，形如 ws/<id>"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "description": "任务 id，由中枢在创建时分配"
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,63}$",
      "description": "操作者标识，例如 user、agent:claude、node:<id>、hub、scheduler"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reply_id": {
          "type": "string",
          "pattern": "^r-[A-Za-z0-9_.-]{1,64}$",
          "description": "回复 id，由中枢在收到回复时分配"
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "approve",
            "deny"
          ],
          "description": "text 文字回复；approve 批准；deny 拒绝（可以附带理由）"
        },
        "via": {
          "type": "string",
          "enum": [
            "telegram",
            "web",
            "cli",
            "supervisor"
          ],
          "description": "回复发起的渠道；supervisor 表示 supervisor 代用户回复"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        },
        "matched_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "rule": {
                "type": "object",
                "properties": {
                  "scope": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "*"
                      },
                      {
                        "type": "string",
                        "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                        "description": "workspace 标识，形如 ws/<id>"
                      },
                      {
                        "type": "string",
                        "pattern": "^[^\\s/*]+$"
                      }
                    ]
                  },
                  "action": {
                    "type": "string",
                    "pattern": "^[^\\s]+$"
                  },
                  "level": {
                    "type": "string",
                    "enum": [
                      "notify",
                      "draft-approve",
                      "supervisor",
                      "auto-report",
                      "auto"
                    ]
                  },
                  "when": {
                    "type": "object",
                    "properties": {
                      "command_prefix": {
                        "description": "按原始命令词严格匹配前缀（不消去环境变量赋值、包装命令或执行文件路径，只接受空格与可见 ASCII）；串联请求的每段命令都必须满足",
                        "type": "string",
                        "minLength": 1
                      },
                      "paths": {
                        "description": "每个请求路径都须匹配至少一个模式；支持 *、**、?，路径使用 /",
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "push_to": {
                        "description": "只用于 git.push：单段 git push 推到执行器上报的任务分支（非默认分支），节点上报 push_env_ok，命令在任务 worktree 中执行；任何不确定都不满足",
                        "type": "string",
                        "const": "task_branch"
                      },
                      "gh_scope": {
                        "description": "用于 gh pr create|view|diff：不带 -R/--repo 与 --body-file、无环境变量前缀、--head 只能是任务分支、节点上报 gh_env_ok，命令在任务 worktree 中执行",
                        "type": "string",
                        "const": "workspace_repo"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "scope",
                  "action",
                  "level"
                ],
                "additionalProperties": false
              },
              "legacy_tool_action": {
                "type": "boolean",
                "const": true
              },
              "rule_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "rule_index",
              "rule"
            ],
            "additionalProperties": false
          }
        },
        "text": {
          "description": "回复文字或拒绝理由",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "reason": {
          "description": "supervisor 代回复时给出的理由（D15，只用于 via: supervisor）；只进用户可见的每日摘要，不进简报",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "reply_id",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "seq",
    "ts",
    "type",
    "workspace",
    "task_id",
    "actor",
    "payload"
  ],
  "additionalProperties": false,
  "title": "task.replied"
}

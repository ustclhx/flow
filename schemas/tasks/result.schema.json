{
  "$id": "https://flow.local/schemas/tasks/result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "结果摘要"
    },
    "artifacts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "pr",
              "commit",
              "url",
              "other"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "文件路径、PR 链接、提交 sha 或 URL"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false,
        "title": "Task artifact"
      }
    },
    "verify": {
      "default": [],
      "description": "每条验收命令的结果",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cmd": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "执行的 argv"
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "退出码；被信号终止或超时时为 null"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "timed_out": {
            "default": false,
            "type": "boolean"
          },
          "output_tail": {
            "default": [],
            "description": "合并 stdout/stderr 后的末尾若干行",
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "cmd",
          "exit_code",
          "duration_ms"
        ],
        "additionalProperties": false,
        "title": "Verify outcome",
        "description": "一条验收命令的执行结果"
      }
    },
    "executor": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "description": "执行器类型，例如 fake、codex-orca、claude-sdk、codex-exec"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "description": "节点 id，节点首次启动时生成并保存在 state/node-id"
    },
    "reason": {
      "description": "失败原因的机器可读码，例如 timeout（超过 timeout_s 被停止）",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "session": {
      "description": "执行器会话 id（例如 Claude Agent SDK 的 session_id），便于事后查看或恢复",
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "cost": {
      "type": "object",
      "properties": {
        "usd": {
          "description": "估算费用（美元）；未报告时省略",
          "type": "number",
          "minimum": 0
        },
        "turns": {
          "description": "模型往返轮数",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "title": "Task cost",
      "description": "执行器上报的费用与用量（估算）"
    },
    "review": {
      "description": "审查任务的结论；只有 reviewer_roles 角色的 claude-sdk 任务会被中枢采信",
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "approve",
            "changes_requested"
          ],
          "description": "approve 没有阻塞问题；changes_requested 需要修改"
        },
        "blocking": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "notes": {
          "default": "",
          "type": "string",
          "maxLength": 16384
        },
        "reviewed_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "description": "审查时 PR 的 head（执行器记录）"
        }
      },
      "required": [
        "verdict",
        "reviewed_sha"
      ],
      "additionalProperties": false,
      "title": "Review result"
    }
  },
  "required": [
    "summary",
    "executor",
    "node_id"
  ],
  "additionalProperties": false,
  "title": "Flow task result",
  "description": "任务结束（done / failed）时的结果"
}

{
  "$id": "https://raindown.local/schemas/workspace.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "workspace id，与文件名一致；标识写作 ws/<id>"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "显示名称"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "一句话说明"
        },
        "supervisor": {
          "default": {
            "enabled": true,
            "auto_merge": false,
            "merge_method": "squash",
            "allow_no_checks": false,
            "reviewer_roles": [
              "pr-reviewer"
            ],
            "delegate_replies": true,
            "reply_timeout_s": 600,
            "limits": {
              "tasks_per_wake": 5,
              "wakes_per_day": 24,
              "autonomous_wakes_per_day": 4,
              "reply_wakes_per_day": 48,
              "chain_depth": 8,
              "review_rounds": 2,
              "open_questions": 3
            },
            "observe": {
              "replies": false,
              "approvals": false,
              "autonomous": false
            }
          },
          "description": "supervisor 设置（add-m1-supervisor）；缺省全部取默认值",
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "description": "是否唤醒本 workspace 的 supervisor；缺省 true，仅在存在 kind: supervisor 角色时生效",
              "type": "boolean"
            },
            "auto_merge": {
              "default": false,
              "description": "true：审查通过后中枢直接建 merger 任务；默认 false，需要用户在收件箱批准合并",
              "type": "boolean"
            },
            "merge_method": {
              "default": "squash",
              "description": "pr-merge 的合并方式：squash（默认）、merge 或 rebase",
              "type": "string",
              "enum": [
                "squash",
                "merge",
                "rebase"
              ]
            },
            "allow_no_checks": {
              "default": false,
              "description": "true：PR 没有任何检查时也允许合并；默认 false（至少要有一项检查且全部成功）",
              "type": "boolean"
            },
            "reviewer_roles": {
              "default": [
                "pr-reviewer"
              ],
              "description": "审查结论被采信的角色（只接受 claude-sdk 执行器）；默认 [pr-reviewer]",
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                "description": "角色名"
              }
            },
            "delegate_replies": {
              "default": true,
              "description": "卡住时先交给 supervisor 代回复（D15）；启用 supervisor 时默认 true",
              "type": "boolean"
            },
            "reply_timeout_s": {
              "default": 600,
              "description": "代回复的等待秒数，超时转交用户；默认 600",
              "type": "integer",
              "minimum": 30,
              "maximum": 86400
            },
            "limits": {
              "default": {
                "tasks_per_wake": 5,
                "wakes_per_day": 24,
                "autonomous_wakes_per_day": 4,
                "reply_wakes_per_day": 48,
                "chain_depth": 8,
                "review_rounds": 2,
                "open_questions": 3
              },
              "type": "object",
              "properties": {
                "tasks_per_wake": {
                  "default": 5,
                  "description": "每次唤醒最多创建的任务数，超出返回 limit_exceeded；默认 5",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "wakes_per_day": {
                  "default": 24,
                  "description": "每天普通唤醒（instruction + autonomous，不含 reply）的次数上限；默认 24",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "autonomous_wakes_per_day": {
                  "default": 4,
                  "description": "其中 autonomous 唤醒的次数上限；默认 4",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "reply_wakes_per_day": {
                  "default": 48,
                  "description": "每天代回复（reply）唤醒的次数上限，超出时委托立即转交用户；默认 48",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "chain_depth": {
                  "default": 8,
                  "description": "parent 链深度上限；默认 8",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 64
                },
                "review_rounds": {
                  "default": 2,
                  "description": "同一 PR 的 changes_requested 轮数上限，超出返回 review_rounds_exceeded；默认 2",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "open_questions": {
                  "default": 3,
                  "description": "同一 workspace 未回答的提问上限，超出返回 too_many_questions；默认 3",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                }
              },
              "additionalProperties": false,
              "title": "Supervisor limits",
              "description": "中枢强制的硬性上限（D4）"
            },
            "observe": {
              "default": {
                "replies": false,
                "approvals": false,
                "autonomous": false
              },
              "type": "object",
              "properties": {
                "replies": {
                  "default": false,
                  "description": "true：代答（提问）只记录 supervisor 的判断（task.reply_observed），提问照常转给用户",
                  "type": "boolean"
                },
                "approvals": {
                  "default": false,
                  "description": "true：代批（授权请求）只记录 supervisor 的判断，授权照常推给用户",
                  "type": "boolean"
                },
                "autonomous": {
                  "default": false,
                  "description": "true：autonomous 唤醒中的 task_create、task_propose、pr_merge_request 只写 supervisor.observed_action，不执行",
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "title": "Supervisor observe",
              "description": "observe 模式：逐项只记录不执行（D10）"
            }
          },
          "additionalProperties": false,
          "title": "Workspace supervisor"
        },
        "github": {
          "default": {
            "watch": false
          },
          "description": "PR 订阅与直通设置（D11）；缺省不轮询 PR",
          "type": "object",
          "properties": {
            "watch": {
              "default": false,
              "description": "是否轮询本 workspace 有订阅的 PR（CI、审查与评论）；默认 false",
              "type": "boolean"
            },
            "allowed_users": {
              "description": "其评论算请求的 GitHub 用户（按数字 id 比较）；缺省为该 PR 所属登记仓库 origin 的 owner（仅当 owner 是个人账号），否则为空名单。名单外用户与机器人的内容只作为不可信上下文",
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
              }
            },
            "worker_identity": {
              "description": "worker 在 GitHub 上使用的独立身份（bot 账号或 App）。只有配置了、与中枢 gh 登录不同、且不在 allowed_users 中时，才解除共享身份限制；它发的内容标为 agent，永不算请求。凭证注入 worker 留待后续变更",
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})(?:\\[bot\\])?$"
            }
          },
          "additionalProperties": false,
          "title": "Workspace GitHub settings"
        },
        "kind": {
          "type": "string",
          "const": "product",
          "description": "产品 workspace，可以拥有资源"
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "关联项目仓库的本地路径"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "kind",
        "repos"
      ],
      "additionalProperties": {},
      "title": "product workspace"
    },

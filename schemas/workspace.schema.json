            }
          },
          "additionalProperties": false,
          "title": "Workspace supervisor"
        },
        "kind": {
          "type": "string",
          "const": "function",
          "description": "职能 workspace，不能拥有资源"
        },
        "repos": {
          "description": "关联仓库的本地路径",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "kind"
      ],
      "additionalProperties": {},
      "title": "function workspace"
    }
  ],
  "title": "Flow workspace",
  "description": "config/workspaces/<id>.yaml 的内容"
}

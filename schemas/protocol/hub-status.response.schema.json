{
  "$id": "https://raindown.local/schemas/protocol/hub-status.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "uptime": {
          "type": "number",
          "minimum": 0,
          "description": "中枢已运行的秒数"
        },
        "ledger_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "账本最新序号，空账本为 0"
        },
        "pid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
        },
        "runtime": {
          "type": "string",
          "enum": [
            "bun",
            "node"
          ]
        },
        "schedules": {
          "type": "object",
          "properties": {
            "loaded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "rule_id": {
                    "type": "string"
                  },
                  "rule_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "field": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "message"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "loaded",
            "errors"
          ],
          "additionalProperties": false
        },
        "schedule_errors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "type": "string"
              },
              "rule_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "field": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          }
        },
        "last_backup": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                }
              },
              "required": [
                "path",
                "at"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "secrets": {
          "default": {
            "loaded": 0,
            "missing": [],
            "error": null
          },
          "type": "object",
          "properties": {
            "loaded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "已解析的密钥个数"
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "file"
                ],
                "additionalProperties": false
              },
              "description": "配置中引用了但尚未设置的密钥路径；依赖它们的功能不启动"
            },
            "error": {
              "description": "最近一次解密失败的错误码",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "loaded",
            "missing",
            "error"
          ],
          "additionalProperties": false
        },
        "policies": {
          "default": {
            "loaded": 0,
            "errors": []
          },
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9a-f]{12}$"
            },
            "loaded": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "rule_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "field": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "rule_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "field": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "loaded",
            "errors"
          ],
          "additionalProperties": false
        },
        "channels": {
          "default": [],
          "description": "推送渠道的状态",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "running",
                  "backoff",
                  "disabled",
                  "stopped"
                ],
                "description": "running 正常；backoff 失败后等待重试；disabled 缺少密钥等原因未启动；stopped 正在停止"
              },
              "missing_secrets": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "该渠道缺少的密钥路径"
              },
              "failures": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "连续失败次数"
              },
              "next_retry_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "last_error": {
                "description": "最近一次失败的说明（已脱敏）",
                "type": [
                  "string",
                  "null"
                ]
              },
              "failed_items": {
                "default": 0,
                "description": "记为推送失败（放弃推送或同步）的条目数",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "ignored_inbound": {
                "default": 0,
                "description": "被忽略的入站消息与按钮数（例如陌生 chat 发来的），自中枢启动起计",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "warning": {
                "default": null,
                "description": "需要用户注意的情况，例如\"可能有人在使用同一个 bot token\"",
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_rebound_at": {
                "default": null,
                "description": "最近一次改绑（channel.rebound）的时间",
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "state",
              "missing_secrets",
              "failures",
              "next_retry_at",
              "last_error",
              "failed_items",
              "ignored_inbound",
              "warning",
              "last_rebound_at"
            ],
            "additionalProperties": false
          }
        },
        "pr_watch": {
          "default": {
            "watched": 0,
            "errors": [],
            "identity": null,
            "shared": [],
            "warnings": []
          },
          "description": "PR 订阅采集（harness-neutral D11）的状态",
          "type": "object",
          "properties": {
            "watched": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "正在轮询的 PR 数"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "workspace": {
                    "type": "string",
                    "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                    "description": "workspace 标识，形如 ws/<id>"
                  },
                  "pr": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^https:\\/\\/[A-Za-z0-9.-]+(?::\\d+)?\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+\\/pull\\/[1-9]\\d*$",
                    "description": "PR 链接，例如 https://github.com/owner/repo/pull/12"
                  },
                  "failures": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "message": {
                    "type": "string"
                  },
                  "since": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                    "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                  }
                },
                "required": [
                  "workspace",
                  "pr",
                  "failures",
                  "message",
                  "since"
                ],
                "additionalProperties": false
              },
              "description": "连续 3 次及以上查询失败的 PR（系统问题）"
            },
            "identity": {
              "default": null,
              "description": "中枢 gh 登录；查询失败（ok=false）时按共享身份处理",
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "login": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "login"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "shared": {
              "default": [],
              "description": "共享身份：中枢 gh 登录在允许名单中或无法确认，PR 评论只作上下文；附原因与解除方法",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "workspace": {
                    "type": "string",
                    "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                    "description": "workspace 标识，形如 ws/<id>"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "workspace",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "warnings": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "watched",
            "errors",
            "identity",
            "shared",
            "warnings"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "uptime",
        "ledger_seq",
        "pid",
        "started_at",
        "runtime",
        "schedules",
        "schedule_errors",
        "last_backup",
        "secrets",
        "policies",
        "channels",
        "pr_watch"
      ],
      "additionalProperties": false,
      "title": "GET /v1/hub/status"
    }
  },
  "required": [
    "ok",
    "data"
  ],
  "additionalProperties": false
}

{
  "$id": "https://raindown.local/schemas/protocol/leases-renew.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "lease_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "description": "租约 id，由中枢在分配任务时生成"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
        },
        "cancel_requested": {
          "type": "boolean",
          "description": "为 true 时节点应停止执行器并提交 cancelled"
        },
        "blocked": {
          "description": "本次 blocked 上报对应的事件；request_id 不同则不确认",
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "seq"
          ],
          "additionalProperties": false
        },
        "report": {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "attempt": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "status": {
              "type": "string",
              "enum": [
                "progress",
                "question",
                "ready",
                "blocked",
                "failed",
                "dropped"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "options": {
              "minItems": 2,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  }
                },
                "required": [
                  "label",
                  "description"
                ],
                "additionalProperties": false
              }
            },
            "recommended": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "deliverables": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048,
                "format": "uri"
              }
            },
            "missing": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "tried": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "handback": {
              "type": "object",
              "properties": {
                "pr_event_seq": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              },
              "required": [
                "pr_event_seq",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "seq",
            "attempt",
            "status",
            "summary"
          ],
          "additionalProperties": false
        },
        "branch_report": {
          "description": "续约带了 branch 时的处理结果（D15）：recorded 已写入；ignored 已上报过或被拒绝（节点不再上报）；retry 临时失败（例如数据库忙），节点保留并重发",
          "type": "string",
          "enum": [
            "recorded",
            "ignored",
            "retry"
          ]
        },
        "reply": {
          "default": null,
          "description": "任务处于 blocked 时最早一条未送达的回复；节点交给执行器后用 ack-reply 确认，确认前每次续约都会返回它",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "reply_id": {
                  "type": "string",
                  "pattern": "^r-[A-Za-z0-9_.-]{1,64}$",
                  "description": "回复 id，由中枢在收到回复时分配"
                },
                "block_seq": {
                  "description": "这条回复所针对的 task.blocked seq",
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "approval_fingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "节点上报的授权弹窗 SHA-256，用于恢复时核对原请求"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "text",
                    "approve",
                    "deny"
                  ],
                  "description": "text 文字回复；approve 批准；deny 拒绝（可以附带理由）"
                },
                "text": {
                  "type": "string"
                },
                "by": {
                  "type": "string",
                  "description": "回复者（task.replied 的 actor）"
                }
              },
              "required": [
                "reply_id",
                "kind",
                "by"
              ],
              "additionalProperties": false,
              "title": "Task reply",
              "description": "待送达给执行器的一条回复"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lease_id",
        "expires_at",
        "cancel_requested",
        "reply"
      ],
      "additionalProperties": false,
      "title": "POST /v1/leases/:id/renew 响应"
    }
  },
  "required": [
    "ok",
    "data"
  ],
  "additionalProperties": false
}

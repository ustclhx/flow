{
  "$id": "https://flow.local/schemas/protocol/leases-acquire.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "lease": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "lease_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "description": "租约 id，由中枢在分配任务时生成"
                },
                "lease_token": {
                  "type": "string",
                  "minLength": 16,
                  "description": "租约令牌；续约与提交时必须携带"
                },
                "task_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "description": "任务 id，由中枢在创建时分配"
                },
                "workspace": {
                  "type": "string",
                  "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                  "description": "workspace 标识，形如 ws/<id>"
                },
                "contract": {
                  "type": "object",
                  "properties": {
                    "goal": {
                      "type": "string",
                      "minLength": 1,
                      "description": "任务目标"
                    },
                    "workspace": {
                      "type": "string",
                      "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                      "description": "workspace 标识，形如 ws/<id>"
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1,
                      "description": "角色，例如 developer、reviewer、triage"
                    },
                    "executor": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$",
                      "description": "执行器类型，例如 fake、codex-orca、claude-sdk、codex-exec"
                    },
                    "requires": {
                      "default": [],
                      "description": "所需节点能力；匹配时 executor:<executor> 视为隐含必需，不必重复写出",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 512,
                        "pattern": "^[a-z][a-z0-9_-]*(:.+)?$",
                        "description": "节点能力，例如 browser、executor:fake、repo:/path/to/repo"
                      }
                    },
                    "cwd": {
                      "description": "工作目录（兼容历史合同的路径）",
                      "type": "string",
                      "minLength": 1
                    },
                    "context": {
                      "description": "上下文引用：brain 条目 id 或文件路径",
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "verify": {
                      "description": "验收命令，按顺序执行",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "cmd": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "命令 argv 数组（不经 shell），例如 [\"bun\", \"test\"]"
                          },
                          "cwd": {
                            "description": "工作目录；缺省为任务的 cwd",
                            "type": "string",
                            "minLength": 1
                          },
                          "timeout_s": {
                            "description": "单条命令超时秒数，缺省为 600（10 分钟）",
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "cmd"
                        ],
                        "additionalProperties": false,
                        "title": "Verify step",
                        "description": "一条验收命令"
                      }
                    },
                    "timeout_s": {
                      "default": 3600,
                      "description": "单次尝试的超时秒数，默认 3600",
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "no_progress_minutes": {
                      "description": "无进展阈值（分钟）：执行器这么久没有任何新活动即上报 blocked(no_progress)；缺省取角色设置，再缺省为 15",
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 10080
                    },
                    "retry": {
                      "description": "重试策略；缺省为不重试（执行器可能已有副作用）",
                      "type": "object",
                      "properties": {
                        "max_attempts": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100,
                          "description": "最多尝试次数（含第一次）；1 等同于不重试"
                        }
                      },
                      "required": [
                        "max_attempts"
                      ],
                      "additionalProperties": false
                    },
                    "parent": {
                      "description": "父任务 id",
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                    },
                    "idempotency_key": {
                      "description": "幂等键：同一个键再次提交时返回已有任务",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "inputs": {
                      "description": "执行器专用输入，按执行器类型取用；inputs.fake 仅 executor=fake 可用；inputs.wake、inputs.review、inputs.merge 见 supervisor",
                      "type": "object",
                      "properties": {
                        "fake": {
                          "type": "object",
                          "properties": {
                            "outcome": {
                              "default": "done",
                              "description": "模拟的结束方式",
                              "type": "string",
                              "enum": [
                                "done",
                                "failed",
                                "blocked"
                              ]
                            },
                            "delay_ms": {
                              "default": 0,
                              "description": "结束前等待的毫秒数，用于模拟长时间运行",
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 86400000
                            },
                            "blocked_reason": {
                              "description": "outcome=blocked 时必填的卡住原因",
                              "type": "string",
                              "enum": [
                                "awaiting_approval",
                                "question",
                                "no_progress",
                                "crashed",
                                "node_lost",
                                "other"
                              ]
                            },
                            "message": {
                              "description": "卡住或失败时的说明；done 时作为结果摘要",
                              "type": "string",
                              "minLength": 1
                            },
                            "activity": {
                              "default": [],
                              "description": "执行期间依次上报的输出片段（kind=output）",
                              "maxItems": 1000,
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "script": {
                              "description": "在 activity / delay_ms 之前依次执行的脚本步骤",
                              "maxItems": 1000,
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "object",
                                    "properties": {
                                      "do": {
                                        "type": "string",
                                        "const": "output"
                                      },
                                      "text": {
                                        "type": "string"
                                      }
                                    },
                                    "required": [
                                      "do",
                                      "text"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "do": {
                                        "type": "string",
                                        "const": "wait"
                                      },
                                      "ms": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 86400000
                                      }
                                    },
                                    "required": [
                                      "do",
                                      "ms"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "do": {
                                        "type": "string",
                                        "const": "idle"
                                      },
                                      "hint": {
                                        "description": "随 idle 信号附带的结构化信息，交给 classify",
                                        "type": "object",
                                        "propertyNames": {
                                          "type": "string"
                                        },
                                        "additionalProperties": {}
                                      }
                                    },
                                    "required": [
                                      "do"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "do": {
                                        "type": "string",
                                        "const": "await_reply"
                                      }
                                    },
                                    "required": [
                                      "do"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "do": {
                                        "type": "string",
                                        "const": "resumed"
                                      }
                                    },
                                    "required": [
                                      "do"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "do": {
                                        "type": "string",
                                        "const": "exit"
                                      },
                                      "code": {
                                        "anyOf": [
                                          {
                                            "type": "integer",
                                            "minimum": -9007199254740991,
                                            "maximum": 9007199254740991
                                          },
                                          {
                                            "type": "null"
                                          }
                                        ],
                                        "description": "退出码；被信号终止时为 null"
                                      },
                                      "signal": {
                                        "type": "string",
                                        "minLength": 1
                                      }
                                    },
                                    "required": [
                                      "do",
                                      "code"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "do": {
                                        "type": "string",
                                        "const": "hang"
                                      },
                                      "ignore_cancel": {
                                        "default": false,
                                        "type": "boolean"
                                      }
                                    },
                                    "required": [
                                      "do",
                                      "ignore_cancel"
                                    ],
                                    "additionalProperties": false
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "do": {
                                        "type": "string",
                                        "const": "approval"
                                      },
                                      "tool": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 128,
                                        "description": "请求审批的工具名，例如 Bash"
                                      },
                                      "command": {
                                        "description": "命令文本",
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "paths": {
                                        "description": "涉及的路径",
                                        "maxItems": 200,
                                        "type": "array",
                                        "items": {
                                          "type": "string",
                                          "minLength": 1
                                        }
                                      }
                                    },
                                    "required": [
                                      "do",
                                      "tool"
                                    ],
                                    "additionalProperties": false
                                  }
                                ],
                                "title": "Fake executor step"
                              }
                            },
                            "session": {
                              "description": "以 blocked 结束时上报的会话 id（模拟无头执行器的 resume）",
                              "type": "string",
                              "minLength": 1
                            },
                            "deliver_failures": {
                              "description": "deliver 前 N 次抛出异常（模拟临时送达失败）",
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 1000000
                            },
                            "deliver_hangs": {
                              "description": "deliver 前 N 次永不返回（模拟卡死的送达）",
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 1000000
                            },
                            "deliver_delay_ms": {
                              "description": "deliver 耗时（毫秒），模拟缓慢的送达",
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 86400000
                            },
                            "resume": {
                              "description": "任务带着回复重新排队后，下一次执行改按这里的指令",
                              "type": "object",
                              "properties": {
                                "outcome": {
                                  "default": "done",
                                  "description": "模拟的结束方式",
                                  "type": "string",
                                  "enum": [
                                    "done",
                                    "failed",
                                    "blocked"
                                  ]
                                },
                                "delay_ms": {
                                  "default": 0,
                                  "description": "结束前等待的毫秒数，用于模拟长时间运行",
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 86400000
                                },
                                "blocked_reason": {
                                  "description": "outcome=blocked 时必填的卡住原因",
                                  "type": "string",
                                  "enum": [
                                    "awaiting_approval",
                                    "question",
                                    "no_progress",
                                    "crashed",
                                    "node_lost",
                                    "other"
                                  ]
                                },
                                "message": {
                                  "description": "卡住或失败时的说明；done 时作为结果摘要",
                                  "type": "string",
                                  "minLength": 1
                                },
                                "activity": {
                                  "default": [],
                                  "description": "执行期间依次上报的输出片段（kind=output）",
                                  "maxItems": 1000,
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                },
                                "script": {
                                  "description": "在 activity / delay_ms 之前依次执行的脚本步骤",
                                  "maxItems": 1000,
                                  "type": "array",
                                  "items": {
                                    "oneOf": [
                                      {
                                        "type": "object",
                                        "properties": {
                                          "do": {
                                            "type": "string",
                                            "const": "output"
                                          },
                                          "text": {
                                            "type": "string"
                                          }
                                        },
                                        "required": [
                                          "do",
                                          "text"
                                        ],
                                        "additionalProperties": false
                                      },
                                      {
                                        "type": "object",
                                        "properties": {
                                          "do": {
                                            "type": "string",
                                            "const": "wait"
                                          },
                                          "ms": {
                                            "type": "integer",
                                            "minimum": 0,
                                            "maximum": 86400000
                                          }
                                        },
                                        "required": [
                                          "do",
                                          "ms"
                                        ],
                                        "additionalProperties": false
                                      },
                                      {
                                        "type": "object",
                                        "properties": {
                                          "do": {
                                            "type": "string",
                                            "const": "idle"
                                          },
                                          "hint": {
                                            "description": "随 idle 信号附带的结构化信息，交给 classify",
                                            "type": "object",
                                            "propertyNames": {
                                              "type": "string"
                                            },
                                            "additionalProperties": {}
                                          }
                                        },
                                        "required": [
                                          "do"
                                        ],
                                        "additionalProperties": false
                                      },
                                      {
                                        "type": "object",
                                        "properties": {
                                          "do": {
                                            "type": "string",
                                            "const": "await_reply"
                                          }
                                        },
                                        "required": [
                                          "do"
                                        ],
                                        "additionalProperties": false
                                      },
                                      {
                                        "type": "object",
                                        "properties": {
                                          "do": {
                                            "type": "string",
                                            "const": "resumed"
                                          }
                                        },
                                        "required": [
                                          "do"
                                        ],
                                        "additionalProperties": false
                                      },
                                      {
                                        "type": "object",
                                        "properties": {
                                          "do": {
                                            "type": "string",
                                            "const": "exit"
                                          },
                                          "code": {
                                            "anyOf": [
                                              {
                                                "type": "integer",
                                                "minimum": -9007199254740991,
                                                "maximum": 9007199254740991
                                              },
                                              {
                                                "type": "null"
                                              }
                                            ],
                                            "description": "退出码；被信号终止时为 null"
                                          },
                                          "signal": {
                                            "type": "string",
                                            "minLength": 1
                                          }
                                        },
                                        "required": [
                                          "do",
                                          "code"
                                        ],
                                        "additionalProperties": false
                                      },
                                      {
                                        "type": "object",
                                        "properties": {
                                          "do": {
                                            "type": "string",
                                            "const": "hang"
                                          },
                                          "ignore_cancel": {
                                            "default": false,
                                            "type": "boolean"
                                          }
                                        },
                                        "required": [
                                          "do",
                                          "ignore_cancel"
                                        ],
                                        "additionalProperties": false
                                      },
                                      {
                                        "type": "object",
                                        "properties": {
                                          "do": {
                                            "type": "string",
                                            "const": "approval"
                                          },
                                          "tool": {
                                            "type": "string",
                                            "minLength": 1,
                                            "maxLength": 128,
                                            "description": "请求审批的工具名，例如 Bash"
                                          },
                                          "command": {
                                            "description": "命令文本",
                                            "type": "string",
                                            "minLength": 1
                                          },
                                          "paths": {
                                            "description": "涉及的路径",
                                            "maxItems": 200,
                                            "type": "array",
                                            "items": {
                                              "type": "string",
                                              "minLength": 1
                                            }
                                          }
                                        },
                                        "required": [
                                          "do",
                                          "tool"
                                        ],
                                        "additionalProperties": false
                                      }
                                    ],
                                    "title": "Fake executor step"
                                  }
                                },
                                "session": {
                                  "description": "以 blocked 结束时上报的会话 id（模拟无头执行器的 resume）",
                                  "type": "string",
                                  "minLength": 1
                                },
                                "deliver_failures": {
                                  "description": "deliver 前 N 次抛出异常（模拟临时送达失败）",
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 1000000
                                },
                                "deliver_hangs": {
                                  "description": "deliver 前 N 次永不返回（模拟卡死的送达）",
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 1000000
                                },
                                "deliver_delay_ms": {
                                  "description": "deliver 耗时（毫秒），模拟缓慢的送达",
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 86400000
                                }
                              },
                              "required": [
                                "outcome",
                                "delay_ms",
                                "activity"
                              ],
                              "additionalProperties": false,
                              "title": "Fake executor resume inputs"
                            }
                          },
                          "required": [
                            "outcome",
                            "delay_ms",
                            "activity"
                          ],
                          "additionalProperties": false,
                          "title": "Fake executor inputs"
                        },
                        "wake": {
                          "description": "supervisor 唤醒任务的唤醒原因与事件（只供提示词，不作为权限依据）",
                          "type": "object",
                          "properties": {
                            "origin": {
                              "type": "string",
                              "enum": [
                                "instruction",
                                "autonomous",
                                "reply"
                              ],
                              "description": "唤醒来源：instruction、autonomous，或只能代回复卡住的 reply"
                            },
                            "generation": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991,
                              "description": "唤醒代数，从 1 开始"
                            },
                            "events": {
                              "default": [],
                              "maxItems": 200,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "seq": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 9007199254740991,
                                    "description": "账本事件的 seq"
                                  },
                                  "type": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 64,
                                    "description": "事件类型，例如 user.instruction"
                                  },
                                  "ts": {
                                    "type": "string",
                                    "format": "date-time",
                                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                                    "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                                  },
                                  "task_id": {
                                    "description": "相关任务",
                                    "type": "string",
                                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                                  },
                                  "summary": {
                                    "description": "中枢生成的事件说明，例如指令原文、任务结果摘要、卡住说明",
                                    "type": "string",
                                    "maxLength": 4000
                                  },
                                  "data": {
                                    "description": "中枢附上的结构化上下文，例如代回复时的 block_seq、请求的命令、终端末尾、diff_stat、目标与角色",
                                    "type": "object",
                                    "propertyNames": {
                                      "type": "string"
                                    },
                                    "additionalProperties": {}
                                  }
                                },
                                "required": [
                                  "seq",
                                  "type"
                                ],
                                "additionalProperties": false,
                                "title": "Wake event",
                                "description": "唤醒合并的一条账本事件"
                              }
                            },
                            "note": {
                              "description": "附加说明，例如手动放行队列时的提示",
                              "type": "string",
                              "maxLength": 4000
                            }
                          },
                          "required": [
                            "origin",
                            "generation",
                            "events"
                          ],
                          "additionalProperties": false,
                          "title": "Wake inputs"
                        },
                        "review": {
                          "description": "审查任务要审查的 PR 与补充关注点",
                          "type": "object",
                          "properties": {
                            "pr": {
                              "type": "string",
                              "maxLength": 512,
                              "pattern": "^https:\\/\\/[A-Za-z0-9.-]+(?::\\d+)?\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+\\/pull\\/[1-9]\\d*$",
                              "description": "PR 链接，例如 https://github.com/owner/repo/pull/12"
                            },
                            "focus": {
                              "description": "补充关注点（不超过 500 字），不改变判定标准",
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 500
                            }
                          },
                          "required": [
                            "pr"
                          ],
                          "additionalProperties": false,
                          "title": "Review inputs"
                        },
                        "pr": {
                          "description": "写类任务针对的 PR（例如按审查意见修改）；中枢据此统计同一 PR 的修改轮数（D4）",
                          "type": "string",
                          "maxLength": 512,
                          "pattern": "^https:\\/\\/[A-Za-z0-9.-]+(?::\\d+)?\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+\\/pull\\/[1-9]\\d*$"
                        },
                        "merge": {
                          "description": "merger 任务要合并的 PR 与审查任务（pr-merge 执行器会重新核对）",
                          "type": "object",
                          "properties": {
                            "pr": {
                              "type": "string",
                              "maxLength": 512,
                              "pattern": "^https:\\/\\/[A-Za-z0-9.-]+(?::\\d+)?\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+\\/pull\\/[1-9]\\d*$",
                              "description": "PR 链接，例如 https://github.com/owner/repo/pull/12"
                            },
                            "review_task": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                              "description": "给出 approve 结论的审查任务（merger 的 parent）"
                            },
                            "branch": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 255,
                              "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/-]*$",
                              "description": "开出该 PR 的任务上报的任务分支（中枢取自投影）：pr-merge 要求 PR 的 headRefName 等于它且不是 fork PR"
                            }
                          },
                          "required": [
                            "pr",
                            "review_task",
                            "branch"
                          ],
                          "additionalProperties": false,
                          "title": "Merge inputs"
                        }
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "goal",
                    "workspace",
                    "role",
                    "executor",
                    "requires",
                    "timeout_s"
                  ],
                  "additionalProperties": false,
                  "title": "Flow task contract",
                  "description": "创建任务时提交的合同"
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "ttl_s": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "expires_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                },
                "resume": {
                  "description": "任务带着回复重新排队时，本次执行要带上的回复与会话 id",
                  "type": "object",
                  "properties": {
                    "reply": {
                      "type": "object",
                      "properties": {
                        "reply_id": {
                          "type": "string",
                          "pattern": "^r-[A-Za-z0-9_.-]{1,64}$",
                          "description": "回复 id，由中枢在收到回复时分配"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "text",
                            "approve",
                            "deny"
                          ],
                          "description": "text 文字回复；approve 批准；deny 拒绝（可以附带理由）"
                        },
                        "text": {
                          "type": "string"
                        },
                        "by": {
                          "type": "string",
                          "description": "回复者（task.replied 的 actor）"
                        }
                      },
                      "required": [
                        "reply_id",
                        "kind",
                        "by"
                      ],
                      "additionalProperties": false,
                      "title": "Task reply",
                      "description": "待送达给执行器的一条回复"
                    },
                    "session": {
                      "description": "上一轮卡住时执行器上报的会话 id",
                      "type": "string"
                    }
                  },
                  "required": [
                    "reply"
                  ],
                  "additionalProperties": false,
                  "title": "Task resume"
                },
                "wake_token": {
                  "description": "唤醒绑定 token（add-m1-supervisor D6）：只在领到 supervisor 唤醒任务时下发，身份为 supervisor，绑定 workspace 与该唤醒，租约结束或任务结束即失效；旧节点忽略",
                  "type": "string",
                  "minLength": 16
                },
                "repo_snapshot": {
                  "description": "中枢投影中固定的登记仓库快照（D15，任务首次上报分支时采集）；有它时节点不再重新采集；旧节点忽略",
                  "type": "object",
                  "properties": {
                    "remote_url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "^[\\x21-\\x7e]+$",
                      "description": "登记仓库 origin 的地址（只接受 github.com）"
                    },
                    "default_branch": {
                      "description": "登记仓库的默认分支；取不到时省略（push_to 随之不满足）",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255,
                      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/-]*$"
                    }
                  },
                  "required": [
                    "remote_url"
                  ],
                  "additionalProperties": false,
                  "title": "Repo snapshot"
                }
              },
              "required": [
                "lease_id",
                "lease_token",
                "task_id",
                "workspace",
                "contract",
                "attempt",
                "ttl_s",
                "expires_at"
              ],
              "additionalProperties": false,
              "title": "Lease grant"
            },
            {
              "type": "null"
            }
          ],
          "description": "等待结束仍无可领取任务时为 null"
        }
      },
      "required": [
        "lease"
      ],
      "additionalProperties": false,
      "title": "POST /v1/leases 响应"
    }
  },
  "required": [
    "ok",
    "data"
  ],
  "additionalProperties": false
}

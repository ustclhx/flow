{
  "$id": "https://flow.local/schemas/protocol/policy-check.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "level": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "notify",
                "draft-approve",
                "supervisor",
                "auto-report",
                "auto"
              ]
            },
            {
              "type": "string",
              "const": "user"
            }
          ]
        },
        "matched_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "rule": {
                "type": "object",
                "properties": {
                  "scope": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "*"
                      },
                      {
                        "type": "string",
                        "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                        "description": "workspace 标识，形如 ws/<id>"
                      },
                      {
                        "type": "string",
                        "pattern": "^[^\\s/*]+$"
                      }
                    ]
                  },
                  "action": {
                    "type": "string",
                    "pattern": "^[^\\s]+$"
                  },
                  "level": {
                    "type": "string",
                    "enum": [
                      "notify",
                      "draft-approve",
                      "supervisor",
                      "auto-report",
                      "auto"
                    ]
                  },
                  "when": {
                    "type": "object",
                    "properties": {
                      "command_prefix": {
                        "description": "按原始命令词严格匹配前缀（不消去环境变量赋值、包装命令或执行文件路径，只接受空格与可见 ASCII）；串联请求的每段命令都必须满足",
                        "type": "string",
                        "minLength": 1
                      },
                      "paths": {
                        "description": "每个请求路径都须匹配至少一个模式；支持 *、**、?，路径使用 /",
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "push_to": {
                        "description": "只用于 git.push：单段 git push 推到执行器上报的任务分支（非默认分支），节点上报 push_env_ok，命令在任务 worktree 中执行；任何不确定都不满足",
                        "type": "string",
                        "const": "task_branch"
                      },
                      "gh_scope": {
                        "description": "用于 gh pr create|view|diff：不带 -R/--repo 与 --body-file、无环境变量前缀、--head 只能是任务分支、节点上报 gh_env_ok，命令在任务 worktree 中执行",
                        "type": "string",
                        "const": "workspace_repo"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "scope",
                  "action",
                  "level"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "rule_index",
              "rule"
            ],
            "additionalProperties": false
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "notify",
                          "draft-approve",
                          "supervisor",
                          "auto-report",
                          "auto"
                        ]
                      },
                      {
                        "type": "string",
                        "const": "user"
                      }
                    ]
                  },
                  {
                    "type": "string",
                    "const": "skipped"
                  }
                ]
              },
              "matched_rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "rule_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "rule": {
                      "type": "object",
                      "properties": {
                        "scope": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": "*"
                            },
                            {
                              "type": "string",
                              "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                              "description": "workspace 标识，形如 ws/<id>"
                            },
                            {
                              "type": "string",
                              "pattern": "^[^\\s/*]+$"
                            }
                          ]
                        },
                        "action": {
                          "type": "string",
                          "pattern": "^[^\\s]+$"
                        },
                        "level": {
                          "type": "string",
                          "enum": [
                            "notify",
                            "draft-approve",
                            "supervisor",
                            "auto-report",
                            "auto"
                          ]
                        },
                        "when": {
                          "type": "object",
                          "properties": {
                            "command_prefix": {
                              "description": "按原始命令词严格匹配前缀（不消去环境变量赋值、包装命令或执行文件路径，只接受空格与可见 ASCII）；串联请求的每段命令都必须满足",
                              "type": "string",
                              "minLength": 1
                            },
                            "paths": {
                              "description": "每个请求路径都须匹配至少一个模式；支持 *、**、?，路径使用 /",
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "push_to": {
                              "description": "只用于 git.push：单段 git push 推到执行器上报的任务分支（非默认分支），节点上报 push_env_ok，命令在任务 worktree 中执行；任何不确定都不满足",
                              "type": "string",
                              "const": "task_branch"
                            },
                            "gh_scope": {
                              "description": "用于 gh pr create|view|diff：不带 -R/--repo 与 --body-file、无环境变量前缀、--head 只能是任务分支、节点上报 gh_env_ok，命令在任务 worktree 中执行",
                              "type": "string",
                              "const": "workspace_repo"
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "scope",
                        "action",
                        "level"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "rule_index",
                    "rule"
                  ],
                  "additionalProperties": false
                }
              },
              "guarded": {
                "type": "boolean"
              }
            },
            "required": [
              "action",
              "level",
              "matched_rules",
              "guarded"
            ],
            "additionalProperties": false
          }
        },
        "decision_id": {
          "description": "只在判定为 supervisor 档位时返回：本次判定的 id（对应 policy.decided 的 seq），节点上报卡住时带上。其他档位与 dry_run 没有该字段",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "level",
        "matched_rules",
        "actions"
      ],
      "additionalProperties": false,
      "title": "POST /v1/policy/check 响应"
    }
  },
  "required": [
    "ok",
    "data"
  ],
  "additionalProperties": false
}

{
  "$id": "https://flow.local/schemas/protocol/events.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "after": {
      "default": 0,
      "description": "只发送 seq 大于它的事件",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "description": "任务 id，由中枢在创建时分配"
    },
    "workspace": {
      "type": "string",
      "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
      "description": "workspace 标识，形如 ws/<id>"
    }
  },
  "additionalProperties": false,
  "title": "GET /v1/events 查询参数"
}

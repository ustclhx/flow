{
  "$id": "https://flow.local/schemas/protocol/health.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "uptime": {
          "type": "number",
          "minimum": 0,
          "description": "中枢已运行的秒数"
        },
        "ledger_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "账本最新序号，空账本为 0"
        }
      },
      "required": [
        "version",
        "uptime",
        "ledger_seq"
      ],
      "additionalProperties": false,
      "title": "GET /v1/health"
    }
  },
  "required": [
    "ok",
    "data"
  ],
  "additionalProperties": false
}

{
  "$id": "https://flow.local/schemas/protocol/supervisor-status.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "workspace": {
                "type": "string",
                "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                "description": "workspace 标识，形如 ws/<id>"
              },
              "enabled": {
                "type": "boolean",
                "description": "当前能否唤醒（启用、有唯一的只读 supervisor 角色）"
              },
              "reason": {
                "description": "不能唤醒的原因",
                "type": [
                  "string",
                  "null"
                ]
              },
              "current": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "task_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                        "description": "任务 id，由中枢在创建时分配"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "instruction",
                          "autonomous",
                          "reply"
                        ],
                        "description": "唤醒来源：instruction、autonomous，或只能代回复卡住的 reply"
                      },
                      "generation": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "description": "唤醒代数，从 1 开始"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "queued",
                          "running",
                          "verifying",
                          "done",
                          "failed",
                          "blocked",
                          "cancelled"
                        ],
                        "description": "任务状态"
                      },
                      "events": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "started_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                        "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                      },
                      "finished_at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                            "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "task_id",
                      "origin",
                      "generation",
                      "status",
                      "events",
                      "started_at",
                      "finished_at"
                    ],
                    "additionalProperties": false,
                    "title": "Wake summary"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "未结束的普通唤醒"
              },
              "reply": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "task_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                        "description": "任务 id，由中枢在创建时分配"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "instruction",
                          "autonomous",
                          "reply"
                        ],
                        "description": "唤醒来源：instruction、autonomous，或只能代回复卡住的 reply"
                      },
                      "generation": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "description": "唤醒代数，从 1 开始"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "queued",
                          "running",
                          "verifying",
                          "done",
                          "failed",
                          "blocked",
                          "cancelled"
                        ],
                        "description": "任务状态"
                      },
                      "events": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "started_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                        "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                      },
                      "finished_at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                            "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "task_id",
                      "origin",
                      "generation",
                      "status",
                      "events",
                      "started_at",
                      "finished_at"
                    ],
                    "additionalProperties": false,
                    "title": "Wake summary"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "未结束的 reply 唤醒"
              },
              "queues": {
                "type": "object",
                "properties": {
                  "instruction": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "autonomous": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reply": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "instruction",
                  "autonomous",
                  "reply"
                ],
                "additionalProperties": false,
                "description": "各队列待处理的事件数"
              },
              "paused": {
                "type": "object",
                "properties": {
                  "instruction": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "failures": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991,
                            "description": "连续失败次数"
                          },
                          "until": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                            "description": "到此时间自动恢复一次"
                          }
                        },
                        "required": [
                          "failures",
                          "until"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "autonomous": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "failures": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991,
                            "description": "连续失败次数"
                          },
                          "until": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                            "description": "到此时间自动恢复一次"
                          }
                        },
                        "required": [
                          "failures",
                          "until"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "instruction",
                  "autonomous"
                ],
                "additionalProperties": false,
                "description": "因连续失败暂停的普通队列"
              },
              "release_pending": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "instruction",
                    "autonomous"
                  ]
                },
                "description": "已放行、等当前唤醒结束后立即处理的队列"
              },
              "today": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "description": "日期，格式 YYYY-MM-DD"
                  },
                  "wakes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "今日计入上限的普通唤醒数"
                  },
                  "autonomous": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reply": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "wakes_per_day": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "autonomous_wakes_per_day": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "reply_wakes_per_day": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cost_usd": {
                    "description": "今天结束的唤醒任务（含 reply）已上报的 result.cost.usd 之和（估算，D13）",
                    "type": "number",
                    "minimum": 0
                  },
                  "cost_wakes": {
                    "description": "今天结束的唤醒任务数（含 reply），其中未上报费用的见 cost_unreported",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cost_unreported": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "date",
                  "wakes",
                  "autonomous",
                  "reply",
                  "wakes_per_day",
                  "autonomous_wakes_per_day",
                  "reply_wakes_per_day"
                ],
                "additionalProperties": false
              },
              "last": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "task_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                        "description": "任务 id，由中枢在创建时分配"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "instruction",
                          "autonomous",
                          "reply"
                        ],
                        "description": "唤醒来源：instruction、autonomous，或只能代回复卡住的 reply"
                      },
                      "generation": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "description": "唤醒代数，从 1 开始"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "queued",
                          "running",
                          "verifying",
                          "done",
                          "failed",
                          "blocked",
                          "cancelled"
                        ],
                        "description": "任务状态"
                      },
                      "events": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "started_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                        "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                      },
                      "finished_at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                            "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "task_id",
                      "origin",
                      "generation",
                      "status",
                      "events",
                      "started_at",
                      "finished_at"
                    ],
                    "additionalProperties": false,
                    "title": "Wake summary"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "最近一次已结束的唤醒"
              }
            },
            "required": [
              "workspace",
              "enabled",
              "reason",
              "current",
              "reply",
              "queues",
              "paused",
              "release_pending",
              "today",
              "last"
            ],
            "additionalProperties": false,
            "title": "Supervisor workspace status"
          }
        }
      },
      "required": [
        "workspaces"
      ],
      "additionalProperties": false,
      "title": "GET /v1/supervisor/status"
    }
  },
  "required": [
    "ok",
    "data"
  ],
  "additionalProperties": false
}

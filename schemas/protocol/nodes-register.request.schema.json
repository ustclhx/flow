{
  "$id": "https://flow.local/schemas/protocol/nodes-register.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "description": "节点 id，节点首次启动时生成并保存在 state/node-id"
    },
    "hostname": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^[a-z][a-z0-9_-]*(:.+)?$",
        "description": "节点能力，例如 browser、executor:fake、repo:/path/to/repo"
      },
      "description": "节点能力，含执行器贡献的 executor:<type>"
    },
    "executors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "description": "执行器类型，例如 fake、codex-orca、claude-sdk、codex-exec"
          },
          "mode": {
            "description": "交互式（如 codex-orca）或无头（如 claude-sdk）；由变更 ② 使用",
            "type": "string",
            "enum": [
              "interactive",
              "headless"
            ]
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "title": "Executor info"
      }
    },
    "concurrency": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "node_id",
    "hostname",
    "version",
    "capabilities"
  ],
  "additionalProperties": false,
  "title": "POST /v1/nodes"
}

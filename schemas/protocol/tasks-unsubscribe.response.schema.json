{
  "$id": "https://raindown.local/schemas/protocol/tasks-unsubscribe.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "subscription": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "description": "任务 id，由中枢在创建时分配"
            },
            "pr": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^https:\\/\\/[A-Za-z0-9.-]+(?::\\d+)?\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+\\/pull\\/[1-9]\\d*$",
              "description": "PR 链接，例如 https://github.com/owner/repo/pull/12"
            },
            "role": {
              "type": "string",
              "enum": [
                "author",
                "reviewer"
              ],
              "description": "author：任务分支开出的 PR；reviewer：审查任务审查的 PR"
            },
            "subscribed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
            },
            "active": {
              "type": "boolean"
            },
            "ended_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                  "description": "ISO 8601 时间，例如 2026-10-24T08:00:00.000Z"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "user",
                    "pr_closed",
                    "not_task_branch",
                    "repo_not_registered"
                  ],
                  "description": "user 用户取消；pr_closed PR 关闭或合并已满保留期；not_task_branch PR 不是由任务分支开出；repo_not_registered PR 不在 workspace 登记的仓库"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "task_id",
            "pr",
            "role",
            "subscribed_at",
            "active",
            "ended_at",
            "reason"
          ],
          "additionalProperties": false,
          "title": "PR subscription"
        },
        "changed": {
          "type": "boolean",
          "description": "false：订阅原本就已结束"
        }
      },
      "required": [
        "subscription",
        "changed"
      ],
      "additionalProperties": false,
      "title": "POST /v1/tasks/:id/unsubscribe 响应"
    }
  },
  "required": [
    "ok",
    "data"
  ],
  "additionalProperties": false
}

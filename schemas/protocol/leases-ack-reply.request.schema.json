{
  "$id": "https://raindown.local/schemas/protocol/leases-ack-reply.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lease_token": {
      "type": "string",
      "minLength": 16
    },
    "reply_id": {
      "type": "string",
      "pattern": "^r-[A-Za-z0-9_.-]{1,64}$",
      "description": "回复 id，由中枢在收到回复时分配"
    },
    "outcome": {
      "default": "delivered",
      "description": "dropped：round_closed 只丢弃该回复并通知用户，保留当前任务状态；request_changed 仅用于 supervisor 的批准，中枢解除卡住后由节点以 no_delegate 重新上报",
      "type": "string",
      "enum": [
        "delivered",
        "not_running",
        "dropped"
      ]
    },
    "reason": {
      "description": "outcome 为 dropped 时必填：拒收的原因",
      "type": "string",
      "enum": [
        "request_changed",
        "round_closed"
      ]
    }
  },
  "required": [
    "lease_token",
    "reply_id"
  ],
  "additionalProperties": false,
  "title": "POST /v1/leases/:id/ack-reply"
}

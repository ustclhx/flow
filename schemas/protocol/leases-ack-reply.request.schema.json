{
  "$id": "https://flow.local/schemas/protocol/leases-ack-reply.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lease_token": {
      "type": "string",
      "minLength": 16
    },
    "reply_id": {
      "type": "string",
      "pattern": "^r-[A-Za-z0-9_.-]{1,64}$",
      "description": "回复 id，由中枢在收到回复时分配"
    },
    "outcome": {
      "default": "delivered",
      "description": "dropped：节点拒收这条回复（例如 supervisor 的批准送达时待批请求已变），中枢写入 task.unblocked 并丢弃它，节点随后以 no_delegate 重新上报卡住",
      "type": "string",
      "enum": [
        "delivered",
        "not_running",
        "dropped"
      ]
    },
    "reason": {
      "description": "outcome 为 dropped 时必填：拒收的原因",
      "type": "string",
      "enum": [
        "request_changed"
      ]
    }
  },
  "required": [
    "lease_token",
    "reply_id"
  ],
  "additionalProperties": false,
  "title": "POST /v1/leases/:id/ack-reply"
}

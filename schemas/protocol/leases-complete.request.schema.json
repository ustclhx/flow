    {
      "type": "object",
      "properties": {
        "lease_token": {
          "type": "string",
          "minLength": 16
        },
        "outcome": {
          "type": "string",
          "const": "blocked"
        },
        "blocked_reason": {
          "type": "string",
          "enum": [
            "awaiting_approval",
            "question",
            "no_progress",
            "crashed",
            "node_lost",
            "other"
          ],
          "description": "卡住原因：awaiting_approval 等审批、question 提问、no_progress 无进展、crashed 崩溃、node_lost 节点掉线（租约过期）、other 其他"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "tail": {
          "description": "末尾输出：最多 200 行，每行最多 2000 字符",
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "session": {
          "description": "执行器会话 id，回复后下一次执行据此恢复",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "decision_id": {
          "description": "策略判定为 supervisor 档位时，这次卡住对应的 policy.decided seq",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "no_delegate": {
          "description": "true：这次卡住不得委托给 supervisor（例如 supervisor 的批准因请求已变而被丢弃）",
          "type": "boolean"
        },
        "diff_stat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "相对任务基点的 git diff --stat 与未提交改动；最多 8192 字符，中枢入账时截到 2000"
        }
      },
      "required": [
        "lease_token",
        "outcome",
        "blocked_reason",
        "message"
      ],
      "additionalProperties": false
    },

{
  "$id": "https://raindown.local/schemas/protocol/session-binding.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task"
            },
            "task": {
              "type": "object",
              "properties": {
                "actor": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,63}$",
                  "description": "操作者标识，例如 user、agent:claude、node:<id>、hub、scheduler"
                },
                "task_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "description": "任务 id，由中枢在创建时分配"
                },
                "workspace": {
                  "type": "string",
                  "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                  "description": "workspace 标识，形如 ws/<id>"
                },
                "lease_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "description": "租约 id，由中枢在分配任务时生成"
                },
                "attempt": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "actor",
                "task_id",
                "workspace",
                "lease_id",
                "attempt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "task"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "wake"
            },
            "wake": {
              "type": "object",
              "properties": {
                "actor": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,63}$",
                  "description": "操作者标识，例如 user、agent:claude、node:<id>、hub、scheduler"
                },
                "task_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "description": "任务 id，由中枢在创建时分配"
                },
                "workspace": {
                  "type": "string",
                  "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                  "description": "workspace 标识，形如 ws/<id>"
                },
                "lease_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                  "description": "租约 id，由中枢在分配任务时生成"
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "instruction",
                    "autonomous",
                    "reply"
                  ]
                },
                "generation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "actor",
                "task_id",
                "workspace",
                "lease_id",
                "origin",
                "generation"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "wake"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "user"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bound"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "ok",
    "data"
  ],
  "additionalProperties": false
}

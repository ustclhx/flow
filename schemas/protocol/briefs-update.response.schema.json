{
  "$id": "https://flow.local/schemas/protocol/briefs-update.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string",
          "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
          "description": "workspace 标识，形如 ws/<id>"
        },
        "file": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "写入后的笔记哈希"
        },
        "sha": {
          "description": "提交 sha；内容未变时为 null",
          "type": [
            "string",
            "null"
          ]
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "workspace",
        "file",
        "hash",
        "sha",
        "changed"
      ],
      "additionalProperties": false,
      "title": "POST /v1/briefs"
    }
  },
  "required": [
    "ok",
    "data"
  ],
  "additionalProperties": false
}

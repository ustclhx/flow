{
  "$id": "https://flow.local/schemas/protocol/supervisor-patrol-report.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspace": {
      "type": "string",
      "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
      "description": "workspace 标识，形如 ws/<id>"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3500,
      "description": "巡检日报正文：写入 journal，并作为 Digest 条目进入每日摘要"
    }
  },
  "required": [
    "workspace",
    "text"
  ],
  "additionalProperties": false,
  "title": "POST /v1/supervisor/patrol-report 请求体"
}

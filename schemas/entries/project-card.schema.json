{
  "$id": "https://flow.local/schemas/entries/project-card.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "project-card",
      "description": "条目类型"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "标题"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "一句话摘要，会出现在 index.md 中"
    },
    "scope": {
      "type": "string",
      "enum": [
        "work",
        "personal"
      ],
      "description": "范围：work 或 personal"
    },
    "tags": {
      "description": "标签",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "description": "出处：raw 中的路径、项目仓库内的路径或 URL；事实类条目需要至少一个",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_verified": {
      "description": "最近一次核实日期（YYYY-MM-DD），未核实时为空",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "日期，格式 YYYY-MM-DD"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace": {
      "type": "string",
      "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
      "description": "项目所属的 workspace（ws/<id>）"
    },
    "repo_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "项目仓库的本地路径"
    },
    "docs": {
      "description": "重要文档的路径",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "type",
    "title",
    "summary",
    "scope",
    "workspace",
    "repo_paths"
  ],
  "additionalProperties": {},
  "title": "project-card",
  "description": "项目卡片：一个产品 workspace 的入口说明"
}

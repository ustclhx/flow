{
  "$id": "https://flow.local/schemas/entries/data-source.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "data-source",
      "description": "条目类型"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "标题"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "一句话摘要，会出现在 index.md 中"
    },
    "scope": {
      "type": "string",
      "enum": [
        "work",
        "personal"
      ],
      "description": "范围：work 或 personal"
    },
    "tags": {
      "description": "标签",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "description": "出处：raw 中的路径、项目仓库内的路径或 URL；事实类条目需要至少一个",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_verified": {
      "description": "最近一次核实日期（YYYY-MM-DD），未核实时为空",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "日期，格式 YYYY-MM-DD"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
      "description": "唯一归属的 workspace（ws/<id>），不能是职能 workspace"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "数据源提供方，例如 sentry、stripe、cloudflare-web-analytics、http-health"
    },
    "endpoint": {
      "description": "访问地址",
      "type": [
        "string",
        "null"
      ]
    },
    "credential": {
      "description": "访问凭据的 secret:// 引用；不得写明文",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^secret:\\/\\/[A-Za-z0-9._-]+(\\/[A-Za-z0-9._-]+)*$",
          "description": "密钥引用，形如 secret://<路径>；不得写明文"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "type",
    "title",
    "summary",
    "scope",
    "owner",
    "provider"
  ],
  "additionalProperties": {},
  "title": "data-source",
  "description": "一个可读取的数据源（资源）"
}

{
  "$id": "https://flow.local/schemas/config/inbox.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "levels": {
      "default": [],
      "description": "分级覆盖规则，按条件多少与先后决定优先级",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "description": "只匹配该来源；缺省匹配所有来源",
            "type": "string",
            "enum": [
              "task",
              "proposal",
              "policy",
              "supervisor",
              "digest"
            ]
          },
          "workspace": {
            "description": "只匹配该 workspace（ws/<id>）；缺省或 * 匹配所有",
            "anyOf": [
              {
                "type": "string",
                "const": "*"
              },
              {
                "type": "string",
                "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
                "description": "workspace 标识，形如 ws/<id>"
              }
            ]
          },
          "reason": {
            "description": "只匹配该卡住原因（任务来源）；缺省匹配所有原因",
            "type": "string",
            "enum": [
              "awaiting_approval",
              "question",
              "no_progress",
              "crashed",
              "node_lost",
              "other"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "interrupt",
              "decide",
              "digest",
              "Interrupt",
              "Decide",
              "Digest"
            ],
            "description": "级别：interrupt、decide 或 digest（首字母大小写均可）"
          }
        },
        "required": [
          "level"
        ],
        "additionalProperties": false,
        "title": "Inbox level rule",
        "description": "一条分级覆盖规则"
      }
    },
    "quiet_hours": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "description": "本地时间 HH:MM（24 小时制）"
            },
            "end": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "description": "本地时间 HH:MM（24 小时制）"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "boolean",
          "const": false
        }
      ],
      "description": "静默时段（默认 23:00–08:00）；Interrupt 顺延到时段结束；false 关闭"
    },
    "decide": {
      "type": "object",
      "properties": {
        "times": {
          "description": "Decide 条目合并推送的时间点，默认 09:00 与 18:00",
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "本地时间 HH:MM（24 小时制）"
          }
        },
        "threshold": {
          "description": "尚未推送的 Decide 条目达到这个数量时提前推送，默认 5",
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "description": "Decide 条目的合并推送"
    },
    "digest": {
      "type": "object",
      "properties": {
        "time": {
          "description": "每日摘要的推送时间，默认 08:30",
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        }
      },
      "additionalProperties": false,
      "description": "每日摘要"
    },
    "snippet_max_chars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4000,
      "description": "外发的终端输出片段保留末尾的字符数，默认 1500；0 表示不发送片段"
    }
  },
  "additionalProperties": false,
  "title": "Flow inbox config",
  "description": "config/inbox.yaml：收件箱配置"
}

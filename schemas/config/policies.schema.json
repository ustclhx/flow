{
  "$id": "https://flow.local/schemas/config/policies.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "scope": {
        "anyOf": [
          {
            "type": "string",
            "const": "*"
          },
          {
            "type": "string",
            "pattern": "^ws\\/[a-z0-9][a-z0-9-]*$",
            "description": "workspace 标识，形如 ws/<id>"
          },
          {
            "type": "string",
            "pattern": "^[^\\s/*]+$"
          }
        ]
      },
      "action": {
        "type": "string",
        "pattern": "^[^\\s]+$"
      },
      "level": {
        "type": "string",
        "enum": [
          "notify",
          "draft-approve",
          "supervisor",
          "auto-report",
          "auto"
        ]
      },
      "when": {
        "type": "object",
        "properties": {
          "command_prefix": {
            "description": "按命令词匹配前缀；串联请求的每段命令都必须满足",
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "description": "每个请求路径都须匹配至少一个模式；支持 *、**、?，路径使用 /",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "push_to": {
            "description": "只用于 git.push：单段 git push 推到执行器上报的任务分支（非默认分支），且节点上报 push_env_ok；任何不确定都不满足",
            "type": "string",
            "const": "task_branch"
          },
          "gh_scope": {
            "description": "用于 gh pr create|view|diff：不带 -R/--repo、无环境变量前缀、节点上报 gh_env_ok，--body-file 只能在 cwd 内",
            "type": "string",
            "const": "workspace_repo"
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "scope",
      "action",
      "level"
    ],
    "additionalProperties": false
  },
  "title": "Flow policies config",
  "description": "config/policies.yaml：策略规则数组"
}
